              "solid": {
                "color": "#E7E7E7"
              }
            },
            "outlineColor": {
              "solid": {
                "color": "#339645"
              }
            }
          }
        ],
        "font": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 11
          }
        ],
        "columnHeaders": [
          {
            "autoSizeColumnWidth": false,
            "backColor": {
              "solid": {
                "color": "#EEEEEE"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 11
          }
        ]
      }
    },
    "pivotTable": {
