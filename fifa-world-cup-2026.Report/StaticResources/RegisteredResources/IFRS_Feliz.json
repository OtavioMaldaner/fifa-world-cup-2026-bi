{
  "name": "IFRS Feliz",
  "$schema": "reportSchema.json",
  "dataColors": [
    "#0B3D2E",
    "#1F7A4D",
    "#39A96B",
    "#6B776F",
    "#2E5947",
    "#7FBF9E",
    "#A8B5AE"
  ],
  "visualStyles": {
    "*": {
      "*": {
        "general": [
          {
            "responsive": true,
            "keepLayerOrder": true
          }
        ],
        "background": [
          {
            "show": true,
            "transparency": 0,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "legend": [
          {
            "show": true,
            "showTitle": false,
            "position": "Top",
            "fontFamily": "Segoe UI",
            "fontSize": 11
          }
        ],
        "border": [
          {
            "show": true,
            "radius": 6,
            "color": {
              "solid": {
                "color": "#DCE4DF"
              }
            }
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#EEEEEE"
              }
            },
            "headerSize": 10
          }
        ],
        "filterCard": [
          {
            "$id": "Applied",
            "backgroundColor": {
              "solid": {
                "color": "#C8C6C4"
              }
            },
            "textSize": 10,
            "transparency": 0
          },
          {
            "$id": "Available",
            "backgroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#333333"
              }
            },
            "textSize": 10,
            "transparency": 0
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "preset": "Bottom",
            "shadowDistance": 1,
            "shadowBlur": 4,
            "shadowSpread": 1,
            "angle": 45,
            "transparency": 92,
            "color": {
              "solid": {
                "color": "#17221C"
              }
            },
            "position": "Outer"
          }
        ],
        "calloutValue": [
          {
            "fontFamily": "Segoe UI"
          }
        ],
        "cardTitle": [
          {
            "fontFamily": "Segoe UI"
          }
        ],
        "value": [
          {
            "$id": "default",
            "fontFamily": "Segoe UI"
          }
        ],
        "valueAxis": [
          {
            "titleFontFamily": "Segoe UI",
            "fontFamily": "Segoe UI",
            "fontSize": 11,
            "show": false,
            "showAxisTitle": false,
            "start": "auto",
            "axisType": "categorical",
            "secTitleFontFamily": "Segoe UI"
          }
        ],
        "categoryAxis": [
          {
            "titleFontFamily": "Segoe UI",
            "show": true,
            "fontSize": 11,
            "showAxisTitle": false,
            "concatenateLabels": false,
            "secTitleFontFamily": "Segoe UI",
            "maxMarginFactor": 50
          }
        ],
        "labels": [
          {
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 11,
            "color": {
              "solid": {
                "color": "#000000"
              }
            },
            "enableBackground": true,
            "backgroundTransparency": 30,
            "backgroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "bold": true,
            "labelOrientation": 1,
            "labelPosition": "OutsideEnd",
            "labelPrecision": 1,
            "labelDisplayUnits": 1,
            "targetValueFontFamily": "Segoe UI"
          }
        ],
        "title": [
          {
            "show": true,
            "position": "left",
            "alignment": "left",
            "showTitle": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "bold": true,
            "fontColor": {
              "solid": {
                "color": "#666666"
              }
            },
            "color": {
              "solid": {
                "color": "#17221C"
              }
            }
          }
        ],
        "lineStyles": [
          {
            "lineStyle": "solid",
            "lineChartType": "smooth",
            "interpolationSmooth": "monotoneX"
          }
        ],
        "visualHeader": [
          {
            "show": true,
            "showVisualInformationButton": false,
            "showVisualWarningButton": false,
            "showVisualErrorButton": false,
            "showDrillRoleSelector": false,
            "showDrillUpButton": true,
            "showDrillToggleButton": true,
            "showDrillDownLevelButton": false,
            "showDrillDownExpandButton": true,
            "showPinButton": false,
            "showFocusModeButton": true,
            "showFilterRestatementButton": false,
            "showSeeDataLayoutToggleButton": false,
            "showOptionsMenu": true,
            "showTooltipButton": true
          }
        ]
      }
    },
    "page": {
      "*": {
        "personalizeVisual": [
          {
            "show": true
          }
        ],
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F3F5F4"
              }
            }
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ],
        "*": [
          {
            "width": 20,
            "height": 20
          }
        ],
        "icon": [
          {
            "$id": "default",
            "topMargin": 0,
            "bottomMargin": 0,
            "leftMargin": 0,
            "rightMargin": 0,
            "lineColor": {
              "solid": {
                "color": "#E6E6E6"
              }
            }
          }
        ]
      },
      "IA": {
        "icon": [
          {
            "show": true
          },
          {
            "$id": "default",
            "shapeType": "qna"
          }
        ],
        "text": [
          {
            "show": true
          },
          {
            "$id": "default",
            "text": "IA",
            "show": true,
            "fontFamily": "Segoe UI",
            "bold": true,
            "fontColor": {
              "solid": {
                "color": "#E6E6E6"
              }
            },
            "horizontalAlignment": "center",
            "topMargin": 2,
            "bottomMargin": 11,
            "leftMargin": 2,
            "rightMargin": 4
          }
        ]
      },
      "Informações": {
        "icon": [
          {
            "$id": "default",
            "shapeType": "information"
          }
        ]
      },
      "Interrogação": {
        "icon": [
          {
            "$id": "default",
            "shapeType": "help"
          }
        ]
      },
      "Informações Extras": {
        "rotation": [
          {
            "shapeAngle": 180
          }
        ],
        "shape": [
          {
            "$id": "default",
            "tileShape": "tabRoundTopCorners",
            "tabRoundCornerTop": 25
          }
        ],
        "icon": [
          {
            "$id": "default",
            "shapeType": "bookmarks",
            "lineColor": {
              "solid": {
                "color": "#666666"
              }
            },
            "lineWeight": 2
          }
        ],
        "fill": [
          {
            "show": true
          },
          {
            "$id": "default",
            "transparency": 0,
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#eee"
              }
            }
          },
          {
            "$id": "hover",
            "transparency": 0,
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#EAF5EC"
              }
            }
          },
          {
            "$id": "selected",
            "transparency": 0,
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#C8C6C4"
              }
            }
          }
        ],
        "text": [
          {
            "show": true
          },
          {
            "$id": "default",
            "show": true,
            "horizontalAlignment": "left",
            "fontSize": 14,
            "fontFamily": "Segoe UI Semibold",
            "leftMargin": 28,
            "topMargin": 0,
            "text": "Aaaaaaaaaaa",
            "fontColor": {
              "solid": {
                "color": "#000000"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "values": [
          {
            "backColorSecondary": {
              "solid": {
                "color": "#F4F4F4"
